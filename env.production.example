#--------------------------------------------------------------------
# Contoh .env untuk hosting (produksi)
#
# Salin file ini menjadi ".env" di folder aplikasi pada server, lalu ganti
# nilai bertanda <...>. Jangan unggah .env dari laptop (berisi setelan lokal).
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

# Alamat situs, diakhiri garis miring. Wajib https setelah SSL aktif.
app.baseURL = 'https://<domain-anda>/'
app.indexPage = ''
app.forceGlobalSecureRequests = true

# Database dari panel hosting (menu MySQL Databases).
database.default.hostname = localhost
database.default.database = <nama_database>
database.default.username = <user_database>
database.default.password = <password_database>
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Buat kunci baru di server: php spark key:generate
# (atau isi dengan nilai acak hex2bin:... yang dibuat sekali, jangan dibagikan)
encryption.key =

# Cookie hanya lewat HTTPS.
cookie.secure = true
